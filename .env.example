# ─── REForge Environment Template ────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit the real .env file — it's in .gitignore

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost

# ── Security (MUST change in production!) ────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-char-string-in-production
ENCRYPTION_KEY=change-this-to-a-random-32-char-string-too

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/app/data/reforge.db

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
GHIDRA_PROJECTS=/app/ghidra_projects

# ── Tool Paths (auto-configured in Docker) ────────────────────────────────────
# For local dev: set to wherever you installed these tools
JADX_CMD=/opt/jadx/bin/jadx
GHIDRA_HOME=/opt/ghidra
